# Login-shell profile (deployed to ~/.zprofile on macOS, ~/.profile elsewhere).
# Keep this machine-agnostic — per-machine bits belong in ~/.zprofile_local.

# vi keybindings on the command line.
set -o vi

# Default editor: nvim locally, vim over SSH (bastions may lack nvim).
# zshrc only fills EDITOR when it is empty, so this takes precedence.
export EDITOR="nvim"
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR="vim"
fi

# Homebrew: path_helper already adds the bin dir via /etc/paths.d/homebrew, but
# this also sets HOMEBREW_PREFIX, MANPATH, INFOPATH, etc.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"

# Go toolchain binaries (go install targets).
if command -v go >/dev/null 2>&1; then
  export PATH="$PATH:$(go env GOPATH)/bin"
fi
export PATH="$PATH:$HOME/go/bin"

# Project-local binaries.
export PATH="$PATH:./bin"

export MANPATH="/usr/local/man:${MANPATH}"

# RVM
export PATH="$PATH:$HOME/.rvm/bin"
[[ -s "$HOME/.rvm/scripts/rvm" ]] && source "$HOME/.rvm/scripts/rvm"

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

# GKE auth plugin (required by kubectl for GKE clusters).
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# Machine-specific overrides (git-ignored; seeded once from zsh/zprofile_local.template).
# Sourced last so it can override anything above; if-form so an absent file
# doesn't leave the login shell's status at 1.
if [[ -f "$HOME/.zprofile_local" ]]; then
  source "$HOME/.zprofile_local"
fi
