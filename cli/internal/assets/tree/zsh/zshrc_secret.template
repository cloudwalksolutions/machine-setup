# .zshrc_secret template
# Copy this to ~/.zshrc_secret and add your personal secrets/API keys
# This file is git-ignored and will not be synced

# Example: API keys
# export OPENAI_API_KEY="your-openai-key-here"
# export ANTHROPIC_API_KEY="your-anthropic-key-here"
# export GEMINI_API_KEY="your-gemini-key-here"

# Example: Personal tokens
# export GITHUB_TOKEN="your-token-here"

# Example: per-account SSH key + gcloud identity switch aliases (personal).
# Swap in your own key filenames and account emails:
# alias work='cp ~/.ssh/id_rsa.work ~/.ssh/id_rsa; cp ~/.ssh/id_rsa.pub.work ~/.ssh/id_rsa.pub; gcloud config set account you@company.com'
# alias personal='cp ~/.ssh/id_rsa.me ~/.ssh/id_rsa; cp ~/.ssh/id_rsa.pub.me ~/.ssh/id_rsa.pub; gcloud config set account you@gmail.com'

