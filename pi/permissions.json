{
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git reset --hard*": "deny"
    },
    "path_read": {
      "~/.ssh/*": "deny"
    },
    "path_write": {
      "~/.ssh/*": "deny",
      "~/.zshrc_secret": "deny",
      "*.env": "deny"
    }
  }
}
